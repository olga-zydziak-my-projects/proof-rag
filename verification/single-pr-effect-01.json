    "billing/checkout.py": {
      "blob": "5b5bcd9cbbdb3ed44a2cda35ce9cd8c5e691e18e",
      "text": "from .records import Invoice, PaymentRequest\nfrom .transport import BankOutbox\n\n\ndef pay_invoice(invoice: Invoice, bank: BankOutbox) -> None:\n    request = PaymentRequest(invoice.invoice_id, invoice.total_minor)\n    bank.send(request)\n"
    },
    "billing/reconciliation.py": {
      "blob": "753a1cd2d680f565c7a1f1976617e3c0eefddbf2",
      "text": "from .records import BankNotice, Invoice\n\n\ndef apply_bank_notice(invoices: dict[str, Invoice], notice: BankNotice) -> bool:\n    invoice = invoices.get(notice.invoice_id)\n    if invoice is None or notice.outcome != \"settled\":\n        return False\n    if notice.amount_minor != invoice.total_minor:\n        return False\n    invoice.status = \"PAID\"\n    return True\n"
    },
    "billing/records.py": {
      "blob": "2288331c209f4c375982d8da34726042e9aae21b",
      "text": "from dataclasses import dataclass\n\n\n@dataclass\nclass Invoice:\n    invoice_id: str\n    total_minor: int\n    status: str = \"OPEN\"\n\n\n@dataclass(frozen=True)\nclass PaymentRequest:\n    invoice_id: str\n    amount_minor: int\n\n\n@dataclass(frozen=True)\nclass BankNotice:\n    invoice_id: str\n    amount_minor: int\n    outcome: str\n"
    },
    "billing/service.py": {
      "blob": "34463f324fd2d577028da588249e7f02b0b0faad",
      "text": "from .checkout import pay_invoice\nfrom .reconciliation import apply_bank_notice\nfrom .records import BankNotice, Invoice\nfrom .transport import BankOutbox\n\n\nclass BillingService:\n    def __init__(self, invoices: dict[str, Invoice], bank: BankOutbox):\n        self.invoices = invoices\n        self.bank = bank\n\n    def pay(self, invoice_id: str) -> None:\n        pay_invoice(self.invoices[invoice_id], self.bank)\n\n    def on_bank_notice(self, notice: BankNotice) -> bool:\n        return apply_bank_notice(self.invoices, notice)\n"
    },
    "billing/transport.py": {
      "blob": "0e814082e9a4fb03f3022b7a2a65b647e725f1c5",
      "text": "from .records import PaymentRequest\n\n\nclass BankOutbox:\n    def __init__(self):\n        self.requests: list[PaymentRequest] = []\n\n    def send(self, request: PaymentRequest) -> None:\n        self.requests.append(request)\n"
    }
  },
